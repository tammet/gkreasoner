# Editor / OS noise
.vscode/
.DS_Store
*~
*.swp

# Nothing here is built from source: no object files should ever appear.
# These are guards in case a source tree is ever copied in by accident.
*.o
*.a
*.so
*.dSYM/

# Local backups of the shipped binaries and Python caches.
bin_backup_*/
__pycache__/
*.pyc

# Local staging area for files awaiting deletion.
to_delete/
