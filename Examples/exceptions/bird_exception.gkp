% Same default, but now there is 90%-believed evidence that a does not fly.
% Where that fact is present, it blocks the default for a and supports
% -flies(a): flies(a) is (.1, .9, 0, 0), while b is untouched. GKP form of bird_exception.js. See Doc/input_languages.md.

bird(a).
bird(b).
0.9::-flies(a).

flies(X) :- bird(X), unless(-flies(X), 2).

query(flies(X)).      % flies(b) (1, 0, 0, 0); flies(a) (.1, .9, 0, 0)
