% The basic birds example in GKP, the Prolog/ProbLog-style surface language.
% This is a translation of bird_penguin.js. gk converts it to JSON-LD-LOGIC
% before proving, and the recursive method keeps the written rule heads, so
% the value differs from bird_penguin.js: see README.md. See also
% Doc/input_languages.md.

bird(b).
0.8::penguin(p).

bird(X) :- penguin(X).
0.9::-flies(X) :- penguin(X).
flies(X) :- bird(X), unless(-flies(X), 2).

query(-flies(X)).
