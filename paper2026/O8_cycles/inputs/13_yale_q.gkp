% Part O8, example 13: the Yale shooting with an atom that a fact makes sure.
alive(s0).
loaded(s0).
result(s0,s1).
result(s1,s2).
happens(shoot,s1).
alive(S2) :- alive(S1), result(S1,S2), unless(-alive(S2), 1).
loaded(S2) :- loaded(S1), result(S1,S2), unless(-loaded(S2), 1).
-alive(S2) :- happens(shoot,S1), loaded(S1), result(S1,S2).
q.
0.9::q :- alive(s2).
query(q).
