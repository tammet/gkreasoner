parcel(p1).
0.9::cold(p1, s0).
0.2::-cold(p1, s0).
plan_step(p1, leg1, s0).
0.3::storm0.
storm1 :- storm0.
storm2 :- storm1.
storm3 :- storm2.
storm4 :- storm3.
storm5 :- storm4.
warmed(p1, leg1, s0) :- storm5.
0.95::handover_ok(p1, do(leg1, s0)).
cold(P, do(A, S)) :- cold(P, S), plan_step(P, A, S), unless(warmed(P, A, S)).
delivered_cold(P, S) :- cold(P, S), handover_ok(P, S).
query(delivered_cold(p1, do(leg1, s0))).
