athlete(p1).
untreated(X) :- person(X), unless(treated(X)).
0.4::asthma(X) :- smokes(X), untreated(X), unless(-asthma(X), 1).
0.7::-asthma(X) :- athlete(X), unless(asthma(X), 2).
query(asthma(p1)).
