% Equipment with a derived identity, the serial number written as a function term:
% serial(U) = serial(V) in the body of the identity clause.
registered(supply(pump)).
registered(supply(controller)).
registered(m17).
serial(supply(pump)) = sn42.
serial(supply(controller)) = sn42.
serial(m17) = sn42.
U = V :- registered(U), registered(V), serial(U) = serial(V).
component(pump).
component(controller).
0.9::charged(supply(pump)).
0.2::-charged(m17).
0.1::-works(pump).
0.15::-works(controller).
works(X) :- component(X), charged(supply(X)), unless(-works(X), 1).
cooling_ready :- works(pump), works(controller).
query(cooling_ready).
